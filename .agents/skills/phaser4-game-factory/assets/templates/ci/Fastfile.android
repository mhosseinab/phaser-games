# apps/<game>/fastlane/Fastfile (Android). See references/04-ci-cd.md.
default_platform(:android)

platform :android do
  desc "Build signed AAB and upload to Play internal track"
  lane :beta do
    keystore = "#{Dir.tmpdir}/release.keystore"
    File.write(keystore, Base64.decode64(ENV['ANDROID_KEYSTORE_FILE']))
    json = Base64.decode64(ENV['PLAY_CONFIG_JSON'])

    # Auto-increment versionCode from the current Play track.
    code = google_play_track_version_codes(
      package_name: ENV['PKG'], track: 'internal', json_key_data: json
    )[0] + 1

    gradle(
      task: 'clean bundleRelease',
      project_dir: 'android/',
      properties: {
        'android.injected.signing.store.file' => keystore,
        'android.injected.signing.store.password' => ENV['KEYSTORE_STORE_PASSWORD'],
        'android.injected.signing.key.alias' => ENV['KEYSTORE_KEY_ALIAS'],
        'android.injected.signing.key.password' => ENV['KEYSTORE_KEY_PASSWORD'],
        'versionCode' => code
      }
    )

    upload_to_play_store(
      package_name: ENV['PKG'],
      json_key_data: json,
      track: 'internal',
      release_status: 'completed',
      aab: 'android/app/build/outputs/bundle/release/app-release.aab'
    )
  end
end
