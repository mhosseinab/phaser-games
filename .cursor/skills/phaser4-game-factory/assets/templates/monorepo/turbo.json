{
  "$schema": "https://turbo.build/schema.json",
  "//": "Turborepo 2.x uses `tasks` (NOT `pipeline`). See references/00-architecture.md and 04-ci-cd.md.",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "public/**", "tsconfig.json", "vite.config.ts", "index.html"],
      "outputs": ["dist/**"]
    },
    "build:native": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": { "dependsOn": ["^build"] },
    "lint": {},
    "test": { "dependsOn": ["^build"] }
  }
}
